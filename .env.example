# Development PostgreSQL connection used by Prisma in later phases.
DATABASE_URL="postgresql://salesflow:salesflow_dev_password@localhost:5432/salesflow?schema=public"

# API runtime
PORT=3001
NODE_ENV=development
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEB_ORIGIN=http://localhost:3000

# Production first-run only: configure a random value of at least 32 characters in the API environment.
# Remove or rotate it after the Store and Owner are created. Never expose it as NEXT_PUBLIC_*.
INITIAL_SETUP_TOKEN=

# Store logo/favicon asset storage. Development defaults to local storage.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
API_PUBLIC_URL=http://localhost:3001

# Required only when STORAGE_PROVIDER=cloudinary (normally production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=
